+func (m *memTable) extendRangeDelEnd(end []byte) {
+	var owned *[]byte
+	for {
+		old := m.rangeDelMaxEnd.Load()
+		if old != nil && m.cmp(end, *old) <= 0 {
+			return
+		}
+		if owned == nil {
+			copy := append([]byte(nil), end...)
+			owned = &copy
+		}
+		if m.rangeDelMaxEnd.CompareAndSwap(old, owned) {
+			return
+		}
+	}
