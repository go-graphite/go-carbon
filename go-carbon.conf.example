[common]
# Opt-in estimated CPU by subsystem: default 1s sample every 60s when enabled.
# Duration must be positive and at most 1/60 of the interval (duty below 2%
# including jitter). Aggregation runs outside the sampling window.
# Off by default; SIGHUP applies changes. Competes with on-demand/Pyroscope CPU profiles.
# phase-cpu-profile-interval = "60s"
# phase-cpu-profile-duration = "1s"
# Run as user. Works only in daemon mode
user = "carbon"
# Prefix for store all internal go-carbon graphs. Supported macroses: {host}
graph-prefix = "carbon.agents.{host}"
# Endpoint to store internal carbon metrics. Valid values: "" or "local", "tcp://host:port", "udp://host:port"
metric-endpoint = "local"
# Interval of storing internal metrics. Like CARBON_METRIC_INTERVAL
metric-interval = "1m0s"
# Increase for configuration with multi persister workers
max-cpu = 4
# Optional heartbeat file, rewritten every heartbeat-interval. A start that finds
# no clean (dump) stop in it logs and records the window of possibly lost cached
# points, for tool/replica-backfill --since-unclean-start. Empty disables it.
heartbeat-file = ""
heartbeat-interval = "10s"
# Return freed C heap memory to the system this often ("0s" disables). Only
# cgo builds on Linux allocate from it: the shared store's block cache and
# memtables. glibc keeps freed chunks in per-thread arenas, so without trims
# resident memory can grow to about twice what the store uses. Each call is
# malloc_trim(0), which walks every arena: seconds on a large fragmented heap,
# so keep the interval at minutes. SIGHUP applies a change.
malloc-trim-interval = "0s"
# Export malloc_system_bytes, malloc_inuse_bytes and malloc_free_bytes (glibc
# 2.33 or later), read after each trim. Reading them walks the arenas too.
malloc-stats = false

[whisper]
data-dir = "/var/lib/graphite/whisper"
# Storage backend: files (default) or experimental pebble-chunk shared storage.
# Shared mode stores metric names in a catalog; it creates no per-metric files.
# See doc/pebble-storage/README.md for the design and tuning, and
# doc/shared-storage.md for migration, quotas and transfer configuration.
storage-backend = "files"
# Pebble chunk store directory defaults to data-dir + "/.store-chunks" when empty.
store-dir = ""
# This budget includes Pebble memtable reservations; leave headroom beyond active
# memtables for block-cache reads. It is not an RSS limit.
store-cache-size = 268435456
store-memtable-size = 67108864
# Background compaction budget. Zero preserves Pebble's default of one worker.
# L0 concurrency adds a compactor for each multiple of this sublevel count,
# capped by the worker budget; zero preserves Pebble's default of ten.
# Tune against sustained queue/debt growth. The worker budget reloads on SIGHUP
# (running compactions finish first); L0 concurrency requires a restart. Neither
# changes the L0 stop-writes threshold. When compactions saturate the device,
# flushes wait behind them and writes stall: fewer workers can raise write
# throughput at the cost of slower debt reduction.
store-compaction-workers = 0
# Aggregate compaction SST output bytes per second: 0 off (default), positive
# fixed budget, -1 automatic. Reloads on SIGHUP, including waiting writes.
# Auto learns unpaced for one hour, then targets 2x the one-hour EWMA of local
# SST ingress times measured write amplification (floor 8 MiB/s). Recent output
# and debt growth supply catch-up headroom for lagging compactions/delete waves.
# Auto bypasses on excess debt (>2x normal and >4 GiB), L0 sublevels >=6 (or half
# the stop threshold), memtable pressure, stalls (plus 5 min), and active/recent
# conversion (5 min since the last activity; an idle migration does not bypass).
# Flushes, WALs and ingest tables stay unpaced. Shutdown bypasses every mode.
# Watch target, bypass reasons, debt and stalls before enabling auto fleetwide.
store-compaction-rate = 0
store-l0-compaction-concurrency = 0
# L0 read amplification that starts an L0 compaction, and that stops writes.
# Hot blocks are rewritten in every flush; a higher compaction threshold drops
# more overwritten versions per byte rewritten, at more L0 read amplification.
# Keep the stop threshold well above it. Zero keeps Pebble's 4 and 12.
# store-l0-compaction-threshold = 0
# store-l0-stop-writes-threshold = 0
# Base level size in bytes; zero keeps Pebble's 64 MiB.
# store-lbase-max-bytes = 0
# Sync new tables that many at a time just before the manifest records them,
# instead of one after another as Pebble finishes each. A flush of 2 MiB L0
# tables otherwise waits for one sync per table in turn, which on a busy device
# is most of the flush time. Durability at each manifest commit is unchanged.
# Zero keeps Pebble's per-table syncs. Requires restart.
# store-parallel-table-syncs = 0
# Flush output table size only (deeper levels keep their sizes). Fewer, larger
# L0 tables need fewer syncs but overlap more of the other L0 sublevels and of
# the base level; 64 MiB once stalled writes on the L0 limit. Zero keeps 2 MiB.
# store-l0-target-file-size = 0
# Bloom filter bits per key in new tables (10 gives about 1% false positives).
# Point reads then skip tables that cannot hold the key instead of searching
# every level. Tables gain filters as compactions rewrite them. Requires
# restart; zero writes no filters.
# store-bloom-filter-bits = 0
# Keep Pebble's write-ahead logs in another directory, usually on another
# device, so WAL writes do not share the store device's write budget. The
# directory must already exist (a missing mount fails startup instead of
# writing the WAL to the root filesystem). Changing it flushes the logs from the
# old location at the next start. Empty keeps them in the store directory.
# Requires restart.
# store-wal-dir = ""
# Block cache shards; zero keeps four per CPU. Raise when readers queue on
# cache shard locks behind the inserts that misses cause. Requires restart.
# store-cache-shards = 0
# Table cache shards; zero keeps Pebble's one per CPU. Requires restart.
# store-table-cache-shards = 0
# Compact the whole store once in the background when this token differs from
# the last finished run (recorded in the store's COMPACTED file), for example to
# drop range tombstones written by older binaries. Requires restart.
# store-compact-once = ""
# Let a block rewritten under the same keys (v6 layout, or the same v7 time
# bucket) overwrite its old groups instead of deleting them first. Reads stop at
# the block's point count, so leftover groups past it are never read; they are
# overwritten as the block refills. Saves a tombstone per old group, which
# compaction otherwise carries down to the bottom level. Requires restart.
# store-reuse-block-keys = false
# Store late points (behind an archive's encoded watermark) in the blocks
# covering their intervals, recomputing the coarse windows they change in place,
# instead of leaving an out-of-order sidecar. Existing sidecars and fallback
# late/coarse points are folded before the update commits, using a full rewrite
# when in-place folding is impossible. Conversion always folds source sidecars;
# a failed fold fails that conversion and retains its source. Direct-write
# conversion also requires a ready, zero sidecar inventory before completion.
# See doc/store-ooo-fold.md for inventory gauges and the resumable admin tool.
# Requires the incremental continuation store. Restart required.
# store-ooo-direct-writes = false
# Serve a fetch's prefix walks and reads of rarely rewritten keys through one
# iterator over the metric's keys instead of one lookup per read. Those reads
# consult bloom filters; prefix walks, like any iterator's, cannot. Requires
# restart.
# store-fetch-shared-iterator = false
# Keep up to this many bytes of recently written or read metrics' committed
# metadata in memory: catalog entries plus each metric's file names, manifests
# and header pages, which every update and fetch otherwise reads back from the
# LSM, opening a table or iterator in each level. An update writes its new
# state through; mutations other than updates drop it. States are kept as
# records in memory the garbage collector does not scan, about 0.5-2 KiB per
# metric; records replaced but not yet compacted add up to an eighth
# (store_metadata_cache_arena_bytes reports the total). 0 (default) disables.
# Requires restart.
# store-metadata-cache-size = 0
# Snappy-pack each cached state's keys when that saves over an eighth of them
# (30-50 % fewer metadata cache bytes per metric in benchmarks, for a decode on
# each cache read). SIGHUP applies it to states sealed afterwards; cached
# states keep their form until rewritten.
# store-metadata-cache-pack = false
# At start, load the metadata cache in the background with the state of the
# metrics the restored cache holds (a pending checkpoint, else the restored
# dump), which the persister writes within one writeout cycle; until each has
# been written once, its first update otherwise reads that state from the LSM.
# It takes the names in the order the persister writes them (the checkpoint's
# claim order, else cache order), reading each batch of 32 in key order
# through one read view, on store-metadata-cache-prewarm-workers workers
# (0: 4) at up to store-metadata-cache-prewarm-rate metrics per second
# (0: unpaced). It skips metrics already cached or being written, never
# evicts, stops when the cache is nearly full, and stops with the store. Needs
# store-metadata-cache-size. Read at start only. Logged as "metadata cache
# prewarmed"; counted by store_metadata_cache_prewarmed_total,
# _prewarm_skipped_total and _prewarm_failed_total.
# store-metadata-cache-prewarm = false
# store-metadata-cache-prewarm-workers = 0
# store-metadata-cache-prewarm-rate = 0
# Give each read of a continuation update its own LSM lookup or iterator again,
# which opens a table in every level it reaches. By default an update's prefix
# walks and reads of rarely rewritten keys share one iterator over the metric's
# keys and the update's batch, which opens each level's table once. SIGHUP
# switches updates that start afterwards; /admin/info reports the current
# choice as engine UpdatePointLookups.
# store-update-point-lookups = false
# Metric names longer than 4000 bytes, or with a node over 255 bytes, are
# refused: no Whisper file could hold them, and their catalog keys bloat the
# index of every table that stores them. This deletes, once in the background
# after start, metrics stored under such names before the limit existed.
# store-purge-invalid-names = false
# Bound on queued (unflushed) memtables. Deeper absorbs write bursts instead of
# stalling writers; a crash replays up to this much WAL. Zero means 8 GiB.
# store-memtable-max-unflushed-bytes = 0
# Soft table-reader file budget; zero preserves Pebble's default of 1,000.
# Large stores may need a higher budget to avoid reopening SSTables. Measure
# CPU, allocations, RSS and descriptor use together. Requires restart.
store-max-open-files = 0
# Pebble WAL sync interval for all mutations, including buckyd transfers/deletes.
# "0s" syncs each committed batch. With periodic sync, a crash can lose mutations
# since the last successful sync; sync delays can extend the interval.
# Requires restart. Ignored by the files backend.
store-sync-interval = "1s"
# Ready metrics to combine in a shared-store commit (1..8). One retains the
# normal path. Eight amortizes synchronous WAL commits; benchmark interval-
# synced workloads before enabling it, as per-key work still dominates.
store-update-batch-size = 1
# Adaptive exact integer deltas / Float64 byte-stream split + Zstd in a separate
# shared format. Empty or "legacy" preserves the existing chunk encoding.
# Requires storage-backend = "pebble-chunk" and a separate store-dir. Late and
# corrected points follow the same atomic archive/WAL path as ordered writes.
store-encoding = "legacy"

# Bounded exact-store canary: write each batch to the original data-dir before
# acknowledging it in the shared store, keeping stock cwhisper rollback current.
# Requires exact encoding, an explicit physically disjoint store-dir, and buckyd
# and shared expiration disabled. This temporarily retains file write overhead.
# A durable MIRROR-RECONCILE-REQUIRED guard prevents reusing the shared store after
# this session until it is reconciled against the current original tree.
# store-mirror-files = false
# Reconcile online while the API reads the current originals, then switch reads
# in-process after full verification. Requires the exact rollback mirror above.
# See doc/shared-exact-live-migration.md.
# store-live-migration = false
# Conversion workers: 0..65536; zero selects four. Incremental conversion I/O
# slots and bytes-in-flight are separate bounds: waiting for an ingest group
# releases the I/O slot but retains its byte reservation. Worker stacks and
# queued metric names use additional memory.
# store-migration-workers = 0
# Optional local JSON lease file for changing active workers without restarting
# the scan. When configured, store-migration-workers is the maximum. Missing,
# invalid or expired leases use one worker; a valid zero-worker lease pauses.
# See doc/shared-exact-live-migration.md for the versioned lease fields.
# store-migration-control-file = ""
# Optional OPERATOR-TRUSTED COMPLETED fully verified original capture tree.
# Requires matching conversion/capture identities and verified-capture receipt;
# never point this at a partial copy. Empty disables unchanged-image skips.
# store-migration-baseline-copy = ""

# Online conversion with immediate per-metric reclamation, for subsequent nodes.
# Uses a NEW empty, physically disjoint store-dir and exact encoding. Each
# verified metric switches reads/writes to shared storage before unlinking its
# CWhisper main/OOO files. Completed work survives restart and worker changes.
# Requires enabled flocked persister, trie carbonserver, file-list-cache-version
# 2, and tags/rollback-mirror/whole-store live migration disabled. Embedded
# buckyd can manage reclaimed shared metrics; pending source cleanup blocks deletes.
# After reclamation rollback requires a compatible binary or replica/backup.
# See doc/incremental-storage-migration.md before enabling this experimental mode.
# store-incremental-migration = false
# Optional same-filesystem archive outside data-dir and store-dir. Originals
# are durably linked here before removal from the active source. Empty reclaims
# them normally. Select before conversion; retain this setting on restarts.
# Archived files are snapshots at each metric's cutover, not a live write mirror.
# store-migration-archive-dir = ""
# Bounds concurrent capture/decode/verification workspace, not total process RSS.
# A single larger metric runs alone and must fit the free-space reserve too.
# store-migration-bytes-in-flight = 268435456
# Reserve for normal writes, index spooling, WAL and compaction; choose per node.
# store-migration-min-free-bytes = 8589934592
# Uses store-migration-workers and store-migration-control-file above. A valid
# zero-worker lease pauses new admission; durable pending cleanup still runs.
# Unlink converted originals at least this long after publication, batched by
# directory, instead of inside each conversion. Freeing inodes next to files
# still being converted makes XFS force its log on those opens. "0s" disables.
# store-migration-reclaim-delay = "0s"
# Deferred reclaim uses store-migration-io-slots directory workers (64 minimum,
# 512 maximum), or 4 per CPU when slots are disabled. Each directory batches up
# to 8192 due originals per sync, independently of other directories. The queue
# holds up to 8388608 jobs including active batches before reclaiming inline.
# Each job is 56 bytes plus its metric name and original path, with additional
# slice capacity and per-directory bookkeeping. Ownership is durable before
# queueing; cleanup completes only after the directory sync.
# Keep newly written compressed blocks in a key space partitioned by the hour
# they are written (store format v7), so compactions of recent writes stop
# rewriting each metric's cold history. Upgrades a v6 store in place: existing
# blocks stay readable and move as they rotate. Older binaries then refuse the
# store, and disabling this later keeps writing v7 blocks.
# store-time-buckets = false
# With time buckets on, move blocks written before the upgrade into the
# history bucket in the background, at about this many bytes per second
# (0 disables). Each metric's newest blocks stay until they rotate. Progress
# survives restarts and is reported as Relayout in the store statistics.
# Changing a positive rate reloads on SIGHUP; enabling or disabling requires a
# restart, so pause a running relayout with a tiny rate such as 1.
# store-time-buckets-relayout-rate = 0

# Automatically remove idle metrics from pebble-chunk storage. "0s" disables
# the global policy. Matching entries in store-expiration-file override this
# value; a matching "0s" explicitly keeps a metric.
# Activity is the last successful storage write, not the sample timestamp.
# Tracking is always on, including while expiration is disabled.
# File conversion preserves the source main-file mtime.
store-expiration = "0s"
# Optional ordered INI file. Each section needs pattern and expiration. The
# first regex match wins, so put keep exceptions before broader namespaces.
# store-expiration-file = "/etc/go-carbon/storage-expiration.conf"
# Cleanup starts immediately when enabled and then runs after each completed
# sweep. It examines this many catalog entries per second in pages of 1024.
# INI rules optionally accept grace (find rounding), exclude (regex) and until
# (RFC3339). A keep rule whose exclusion matches falls through to later rules.
# Defaults are zero grace, no exclusion and no deadline.
store-expiration-check-interval = "1h"
store-expiration-scan-rate = 100000
# Report candidates and logical Whisper-equivalent bytes without any mutation,
# including activity initialization. Start fleet policies in this mode.
store-expiration-dry-run = false
# Deletes use conditional batches of at most 512; scanning has its own budget.
# One shared rate budget across all delete workers (names/second).
store-expiration-delete-rate = 100
# Bounded concurrent delete batches, up to 512 names per batch. Raise the
# delete rate and per-sweep cap too when clearing a backlog. Pressure is checked
# before every batch; batches already in progress finish when pressure rises.
store-expiration-delete-workers = 8
# Expiration batches use atomic unsynced WAL commits even when store writes
# are synchronous. A crash may restore expired names; the next sweep retries.
# Subsequent synced writes or completion of the end-of-sweep flush make deletes durable.
store-expiration-max-deletes = 10000
# Pause deletes for the rest of the sweep on pressure, continuing the report.
store-expiration-max-l0-sublevels = 6
store-expiration-max-compaction-debt = 1073741824
# http://graphite.readthedocs.org/en/latest/config-carbon.html#storage-schemas-conf. Required
schemas-file = "/etc/go-carbon/storage-schemas.conf"
# http://graphite.readthedocs.org/en/latest/config-carbon.html#storage-aggregation-conf. Optional
aggregation-file = "/etc/go-carbon/storage-aggregation.conf"
# It's currently go-carbon only feature, not a standard graphite feature. Optional
# More details in doc/quotas.md
# quotas-file = "/etc/go-carbon/storage-quotas.conf"
# Poll the quota file without restarting components. "0s" disables polling.
# Reloadable via SIGHUP; quota support must be enabled at startup.
quotas-reload-interval = "0s"
# Pebble-chunk only: accept physical-size limits and ignore them while keeping
# all other quota controls active. Ignored by other backends.
# Reloadable via SIGHUP.
pebble-chunk-ignore-physical-quotas = false
# Worker threads count. Metrics sharded by "crc32(metricName) % workers"
workers = 8
# Limits the number of whisper update_many() calls per second. 0 - no limit
max-updates-per-second = 0
# Sparse file creation
sparse-create = false
# use flock on every file call (ensures consistency if there are concurrent read/writes to the same file)
flock = true
enabled = true
# Use hashed filenames for tagged metrics instead of human readable
# https://github.com/go-graphite/go-carbon/pull/225
hash-filenames = true
# specify to enable/disable compressed format (EXPERIMENTAL)
# See details and limitations in https://github.com/go-graphite/go-whisper#compressed-format
# IMPORTANT: Only one process/thread could write to compressed whisper files at a time, especially when you are
# rebalancing graphite clusters (with buckytools, for example), flock needs to be enabled both in go-carbon and your tooling.
compressed = false
# automatically delete empty whisper file caused by edge cases like server reboot
remove-empty-file = false

# Enable online whisper file config migration.
#
# online-migration-rate means metrics per second to migrate.
#
# To partially enable default migration for only some matched rules in
# storage-schemas.conf or storage-aggregation.conf, we can set
# online-migration-global-scope = "-" and enable the migration in the config
# files (more examples in deploy/storage-aggregation.conf and deploy/storage-schemas.conf).
#
# online-migration-global-scope can also be set any combination of the 3 rules
# (xff,aggregationMethod,schema) as a csv string
# like: "xff", "xff,aggregationMethod", "xff,schema",
# or "xff,aggregationMethod,schema".
#
# online-migration = false
# online-migration-rate = 5
# online-migration-global-scope = "-"

# Preserve data points that the compressed format cannot write (EXPERIMENTAL).
#
# cwhisper encodes each block as a delta chain, so a point that is not newer
# than the newest one already in the block cannot be written in place and is
# discarded (see the persister.oooDiscardedPoints metric). That loses late
# arrivals from lagging relays, and makes backfilling history impossible.
#
# With out-of-order enabled those points are written instead to a classic
# whisper sidecar, "<metric>.wsp.ooo", holding the same retentions, and
# merged back in on read. Where the compressed file already has a value it
# wins; the sidecar only fills gaps. The .wsp file itself is unchanged and
# stays readable by any other tool.
#
# Sidecars are folded back into the compressed file once they reach
# out-of-order-compact-threshold bytes of physical (not apparent) size. That is
# a full file rewrite, so it is limited to out-of-order-compact-rate metrics
# per second and is skipped, never queued, when there is no budget.
# Sidecars are always sparse, regardless of sparse-create.
#
# Requires compressed = true. Not supported for mix aggregation.
#
# out-of-order = false
# out-of-order-compact-rate = 5
# out-of-order-compact-threshold = 65536
#
# Optional point-based batching (0 keeps the physical-size policy above).
# When positive, min-points replaces the physical-size trigger. A sidecar is
# eligible when ANY limit is reached: live records >= min-points, oldest sample
# >= max-point-age, or a live record expires within retention-margin.
# Counts include all archives, including propagated aggregates; duplicate
# timestamps occupy one record per archive. Ages use sample timestamps, NOT
# arrival time or sidecar mtime. Already-old backfill can therefore merge early.
# The rate above limits sidecar scans as well as successful compactions. Scans
# read the classic sidecar; only eligible files are rewritten. Monitor
# oooCompactionChecks, oooCompactionDeferred, oooCompactions and oooCompactErrors.
# Checks happen on writes only. Idle files are not swept, and rate limiting can
# delay eligible merges: neither age nor retention-margin is a hard deadline.
# Coarse aggregates can remain stale until compaction. Choose the margin above
# the observed writeout cycle; monitor read correctness and sidecar I/O.
# max-point-age and retention-margin must be positive when min-points is enabled.
# out-of-order-compact-min-points = 0
# out-of-order-compact-max-point-age = "5m"
# out-of-order-compact-retention-margin = "1m"

[cache]
# Limit of in-memory stored points (not metrics)
max-size = 1000000
# Optional additional byte budget, using cache_estimated_bytes (0 disables).
# Includes metric names, compact buffer capacity and input-log tracking. This is
# an estimate, not an RSS limit; leave room for Go GC, Pebble and native memory.
# Batching bypasses its delay above 75% of either limit. Reloadable.
# For example, max-bytes = 34359738368 gives a 32 GiB write-cache budget.
max-bytes = 0
# Capacity of queue between receivers and cache
# Strategy to persist metrics. Values: "max","sorted","noop","lexical"
#   "max" - write metrics with most unwritten datapoints first
#   "sorted" - sort by timestamp of first unwritten datapoint.
#   "noop" - pick metrics to write in unspecified order,
#            requires least CPU and improves cache responsiveness
#   "lexical" - sort eligible metric names to improve shared catalog/block
#               locality. Point order and batching eligibility are unchanged.
write-strategy = "max"

# Opt-in batching before opening Whisper files. Both zero disables batching.
# Example canary: 8 points or "2s" since the oldest pending arrival, whichever
# comes first. Samples remain readable in cache; this adds crash-loss exposure
# and memory use. Existing writer-queue latency is additional to this delay.
# Bypassed above 75% of max-size, for restored data, and during shutdown.
# Reloadable; enabling batching leaves already cached data immediately eligible.
writeout-min-points = 0
writeout-max-delay = "0s"
# Metrics that start batching together (after a restart, say) otherwise reach
# writeout-min-points or their deadline together every cycle, in one
# synchronized write wave. A spread of 0.25 gives each metric a stable
# threshold and max delay between 0.75 and 1 times the configured ones, so the
# waves flatten within a few cycles. Never exceeds the configured values.
# 0 (default) disables. Reloadable.
writeout-max-delay-spread = 0.0
# Place the first batching deadlines across each metric's usual spread period
# from a shared startup epoch, using an independent stable hash. This flattens
# restart write waves from the first cycle; later windows keep the usual
# threshold and delay. No recurring short windows or metric history table.
# The epoch starts at the first batchable arrival, after any urgent replay.
# Arrivals whose startup slot has passed keep their usual window. For startup
# arrivals within a minute, use rate windows of a few minutes to assess spread.
# Opt-in: the initial batch waits for its phase even if it already meets the
# point threshold. Max delay and the cache pressure bypass still apply. Cold
# empty caches ramp up persisted points as their initial batches fill; evenly
# phased writes cannot produce steady points/s immediately from an empty cache.
# Does not defer urgent recovery, or make an unsafe restore batchable. Combine
# with writeout-restore-spread for durable restored batches. With batching off
# it has no effect. Reloadable for later arrivals; the epoch is not restarted.
writeout-startup-spread = false
# After a restart, restored points are otherwise written at once, then each
# metric again with its first live points a cycle later: a burst of small
# writes and compaction. With this on (and batching enabled), restored points
# that stay durable meanwhile wait for a deadline spread over the first
# writeout-max-delay instead: dump points the input log records, and saved
# checkpoint metrics the store already has. New metrics, recovered input-log
# or handoff points, and restores without an input log are still written at
# once. Reloadable for later restores.
writeout-restore-spread = false
# Metrics reporting less often than writeout-max-delay (hourly rollups, say)
# hold one point per window, and those that report at the same minute all
# reach their deadline within its last writeout-max-delay-spread share: an
# hourly burst of updates. With this on (and batching enabled), a metric whose
# new point is at least writeout-max-delay newer than its last written one
# gets a deadline spread, by name, over the whole window instead; it is still
# written once per point. It returns to the usual deadline if more points
# arrive in the window. Metrics are recognized from their second write after
# enabling or a restart; the cache keeps the last written timestamp per hash
# slot, about 16 bytes per cached metric. Independent of
# writeout-max-delay-spread. Reloadable.
writeout-sparse-spread = false
# If > 0 use bloom filter to detect new metrics instead of cache (EXPERIMENTAL)
# works better for multi-million metrics installations
bloom-size = 0

[udp]
listen = ":2003"
enabled = true
# Optional internal queue between receiver and cache
buffer-size = 0

[tcp]
listen = ":2003"
enabled = true
# Optional internal queue between receiver and cache
buffer-size = 0

[pickle]
listen = ":2004"
# Limit message size for prevent memory overflow
max-message-size = 67108864
enabled = true
# Optional internal queue between receiver and cache
buffer-size = 0

# You can define unlimited count of additional receivers
# Common definition scheme:
# [receiver.<any receiver name>]
# protocol = "<any supported protocol>"
# <protocol specific options>
#
# All available protocols:
#
# [receiver.udp2]
# protocol = "udp"
# listen = ":2003"
# # Enable optional logging of incomplete messages (chunked by max UDP packet size)
# log-incomplete = false
#
# [receiver.tcp2]
# protocol = "tcp"
# listen = ":2003"
#
# [receiver.pickle2]
# protocol = "pickle"
# listen = ":2004"
# # Limit message size for prevent memory overflow
# max-message-size = 67108864
#
# [receiver.protobuf]
# protocol = "protobuf"
# # Same framing protocol as pickle, but message encoded in protobuf format
# # See https://github.com/go-graphite/go-carbon/blob/master/helper/carbonpb/carbon.proto
# listen = ":2005"
# # Limit message size for prevent memory overflow
# max-message-size = 67108864
#
# [receiver.http]
# protocol = "http"
# # This receiver receives data from POST requests body.
# # Data can be encoded in plain text format (default),
# # protobuf (with Content-Type: application/protobuf header) or
# # pickle (with Content-Type: application/python-pickle header).
# listen = ":2007"
# max-message-size = 67108864
#
# [receiver.kafka]
# protocol = "kafka
# # This receiver receives data from kafka
# # You can use Partitions and Topics to do sharding
# # State is saved in local file to avoid problems with multiple consumers
#
# # Encoding of messages
# # Available options: "plain" (default), "protobuf", "pickle"
# #   Please note that for "plain" you must pass metrics with leading "\n".
# #   e.x.
# #    echo "test.metric $(date +%s) $(date +%s)" | kafkacat -D $'\0' -z snappy -T -b localhost:9092 -t graphite
# parse-protocol = "protobuf"
# # Kafka connection parameters
# brokers = [ "host1:9092", "host2:9092" ]
# topic = "graphite"
# partition = 0
#
# # Specify how often receiver will try to connect to kafka in case of network problems
# reconnect-interval = "5m"
# # How often receiver will ask Kafka for new data (in case there was no messages available to read)
# fetch-interval = "200ms"
#
# # Path to saved kafka state. Used for restarts
# state-file = "/var/lib/graphite/kafka.state"
# # Initial offset, if there is no saved state. Can be relative time or "newest" or "oldest".
# # In case offset is unavailable (in future, etc) fallback is "oldest"
# initial-offset = "-30m"
#
# # Specify kafka feature level (default: 0.11.0.0).
# # Please note that some features (consuming lz4 compressed streams) requires kafka >0.11
# # You must specify version in full. E.x. '0.11.0.0' - ok, but '0.11' is not.
# # Supported version (as of 22 Jan 2018):
# #   0.8.2.0
# #   0.8.2.1
# #   0.8.2.2
# #   0.9.0.0
# #   0.9.0.1
# #   0.10.0.0
# #   0.10.0.1
# #   0.10.1.0
# #   0.10.2.0
# #   0.11.0.0
# #   1.0.0
# kafka-version = "0.11.0.0"
#
# [receiver.pubsub]
# # This receiver receives data from Google PubSub
# # - Authentication is managed through APPLICATION_DEFAULT_CREDENTIALS:
# #   - https://cloud.google.com/docs/authentication/production#providing_credentials_to_your_application
# # - Currently the subscription must exist before running go-carbon.
# # - The "receiver_*" settings are optional and directly map to the google pubsub
# #   libraries ReceiveSettings (https://godoc.org/cloud.google.com/go/pubsub#ReceiveSettings)
# #   - How to think about the "receiver_*" settings: In an attempt to maximize throughput the
# #     pubsub library will spawn 'receiver_go_routines' to fetch messages from the server.
# #     These goroutines simply buffer them into memory until 'receiver_max_messages' or 'receiver_max_bytes'
# #     have been read. This does not affect the actual handling of these messages which are processed by other goroutines.
# protocol = "pubsub"
# project = "project-name"
# subscription = "subscription-name"
# receiver_go_routines = 4
# receiver_max_messages = 1000
# receiver_max_bytes = 500000000 # default 500MB

[carbonlink]
listen = "127.0.0.1:7002"
enabled = true
# Close inactive connections after "read-timeout"
read-timeout = "30s"

# grpc api
# protocol: https://github.com/go-graphite/go-carbon/blob/master/helper/carbonpb/carbon.proto
# samples: https://github.com/go-graphite/go-carbon/tree/master/api/sample
[grpc]
listen = "127.0.0.1:7003"
enabled = true

# http://graphite.readthedocs.io/en/latest/tags.html
[tags]
enabled = false
# TagDB url. It should support /tags/tagMultiSeries endpoint
tagdb-url = "http://127.0.0.1:8000"
tagdb-chunk-size = 32
tagdb-update-interval = 100
# Directory for send queue (based on leveldb)
local-dir = "/var/lib/graphite/tagging/"
# POST timeout
tagdb-timeout = "1s"

[buckyd]
# Embedded buckytools transfer API. Requires whisper.storage-backend = "pebble-chunk".
enabled = false
bind = "0.0.0.0:4242"
# Empty tmpdir uses the operating system temporary directory.
tmpdir = ""
auth-jwt-secret-file = ""
# Whole-store checkpoint/copy API: /admin/store-copy on this listener, protected
# by the same JWT header with namespaces=["*"] and ops=["admin"] (or root "*").
# Requires input-log.enabled; refuses incomplete conversion, tags, expiration
# and rollback mirrors. Pins input history and SSTs for at most six hours.
# POST creates, POST /capture advances log prefixes, POST /seal drains receivers,
# GET /file streams checksummed ranges, DELETE releases the checkpoint.
# See tool/downsize/README.md for relay fencing, resumption and readiness.
# Source disk reserve for whole-store copy (zero selects 32 GiB). The local
# watchdog aborts/releases a copy on low disk or input-log errors, even if its
# external controller has died. Raise this for production compaction/ingest.
copy-min-free-bytes = 34359738368
# Empty node uses the hostname. Nodes describe the ingestion hashring using
# HOST[:PORT][=INSTANCE]; offload sources do not need to be ring members.
node = ""
nodes = []
# Hosts besides the ring nodes that /v1/transfer/pull may fetch from (host or
# host:port), for example the members of another ring during a resize. Pulls
# to any other host are refused.
transfer-sources = []
hash = "carbon"
replicas = 1
# Optional dedicated pprof listener and Pyroscope collector.
pprof = ""
pyroscope = ""
# Bounds concurrent exports/imports and encoded/decoded import size.
max_transfers = 0 # auto: available CPU concurrency, capped at 64; explicit positive values remain ceilings
max_body_bytes = 167772160
# Legacy catalog-cache TTL in seconds; shared catalog reads have no TTL cache.
timeout = 3600
# Filesystem-only flags below must retain these values in shared mode.
prefix = ""
cache_path = ""
sparse = false
compressed = false
mtime = false
backend = "shared"

[carbonserver]
# Please NOTE: carbonserver is not intended to fully replace graphite-web
# It acts as a "REMOTE_STORAGE" for graphite-web or carbonzipper/carbonapi
listen = "127.0.0.1:8080"
# Carbonserver support is still experimental and may contain bugs
# Or be incompatible with github.com/grobian/carbonserver
enabled = true
# Buckets to track response times
buckets = 10
# Hard limits the number of whisper files that get created each second. 0 - no limit
max-creates-per-second = 0
# carbonserver-specific metrics will be sent as counters
# For compatibility with grobian/carbonserver
metrics-as-counters = false
# Read and Write timeouts for HTTP server
read-timeout = "60s"
write-timeout = "60s"
# Request timeout for each API call
request-timeout = "60s"
# Enable /render cache, it will cache the result for 1 minute
query-cache-enabled = true
# Enable carbonV2 gRPC streaming render cache, it will cache the result for 1 minute
streaming-query-cache-enabled = false
# Maximum size in megabytes, 0 for unlimited
query-cache-size-mb = 0
# Store /render cache entries in this encoding: "gzip" or "none".
# gzip entries take several times less memory and count their compressed size
# against query-cache-size-mb. They are served as is to clients that accept
# gzip and decoded for the others.
query-cache-compression = "gzip"
# Enable /metrics/find cache, it will cache the result for 5 minutes
find-cache-enabled = true
# Maximum size in megabytes, 0 for unlimited
find-cache-size-mb = 0
# Enable expanded globs cache, it will cache the glob expansion result for 5 minutes
glob-cache-enabled = true
# Maximum size in megabytes, 0 for unlimited
glob-cache-size-mb = 0
# Control trigram index
#  This index is used to speed-up /find requests
#  However, it will lead to increased memory consumption
#  Estimated memory consumption is approx. 500 bytes per each metric on disk
#  Another drawback is that it will recreate index every scan-frequency interval
#  All new/deleted metrics will still be searchable until index is recreated
trigram-index = true
# carbonserver keeps track of all available whisper files in memory. 
# This determines how often it will check FS for new or deleted metrics.
# If you only use the trie index, have 'realtime-index' > 0, and delete metrics 
# unfrequently you can have a very low scan frequency.
# Ex : you delete metrics only once every 24 hours, you can have a 24H scan frequency
scan-frequency = "5m0s"
# Control trie index
#  This index is built as an alternative to trigram index, with shorter indexing
#  time and less memory usage (around 2 - 5 times). For most of the queries,
#  trie is faster than trigram. For queries with keyword wrap around by widcards
#  (like ns1.ns2.*keywork*.metric), trigram index performs better. Trie index
#  could be speeded up by enabling adding trigrams to trie, at the some costs of
#  memory usage (by setting both trie-index and trigram-index to true).
trie-index = false
# Control how frequent it is to generate quota and usage metrics, and reset
# throughput counters (More details in doc/quotas.md).
# quota-usage-report-frequency = "1m"

# Cache file list scan data in the specified path. This option speeds
# up index building after reboot by reading the last scan result in file
# system instead of scanning the whole data dir, which could takes up
# most of the indexing time if it contains a high number of metrics (10
# - 40 millions). go-carbon only reads the cached file list once after
# reboot and the cache result is updated after every scan. (EXPERIMENTAL)
#
# file-list-cache = "/var/lib/carbon/carbonserver-file-list-cache.bin"

# Supported FLC (file list cache) version values are: 2, 1 (default value is 1
# for backward compatibility).
#
# File list cache v2 is is more advanced of file list cache for go-carbon, with
# good quota support during restarts (by keeping physical, logical sizes, metric
# creation time in the cache). For more details, see carbonserver/flc.go.
#
# V2 file is no longer a plain text file compressed with gzip, but a semi-binary
# file. For reading flc v2 cache file, use go-carbon with flag -print-file-list-cache:
#
#     go-carbon -print-file-list-cache /var/lib/carbon/carbonserver-file-list-cache.bin
#
# For upgrade or downgrade to v2 or v1, you can just update the config,
# go-carbon would transparently detect the existing cache file on restart. No
# manual deletion needed.
#
# file-list-cache-version = 2

# Number of goroutines walking the whisper tree during a full index scan.
# Workers split the tree into ranges of the previous index snapshot and build
# the next snapshot and file list cache in parallel. Directories that did not
# change since the previous parallel scan are not read again: their listings
# come from the previous snapshot, while every metric file is still stat'ed.
# Requires trie-index, concurrent-index, file-list-cache-version = 2 and an
# existing snapshot, and is not used with internal-stats-dir. 0 picks a quarter
# of the CPUs, at least 2 and at most 16; 1 keeps the sequential scan.
#
# scan-workers = 0

# Enable concurrently building index without maintaining a new copy
# index structure. More memory efficient.
# Currently only trie-index is supported. (EXPERIMENTAL)
concurrent-index = false

# Set to larger than 0 to enable realtime indexing of new metrics,
# The value controls how many new metrics could be buffered at once. Suitable to
# adjust it higher if there are high number of new metrics being produced.
# Currently only trie-index is supported. 
# (EXPERIMENTAL)
realtime-index = 0

# Maximum inflight requests allowed in go-carbon. Default is 0 which means no limit.
# If limit is reached, go-carbon/carbonserver returns 429 (Too Many Requests).
# This option would be handy as if there are too many long running requests piling up,
# it would slows down data ingestion in persister and slows down index building
# (especially during restart).
max-inflight-requests = 0

# Returns 503 (Service Unavailable) when go-carbon is still building the first
# index cache (trie/trigram) after restart. With trie or trigram index,
# carbonserver falls back to filepath.Glob when index is not ready. And
# filepath.Glob is expensive and not scaled enough to support some heavy
# queries (manifested as high usage and frequent GC). Thus it is possible that
# the read requests is so heavy that it not only slows down index building, it
# also hinders persister from flushing down data to disk and causing cache.size
# overflow.
#
# By default, it is disabled.
#
# It is recommend to enable this flag together with "file-list-cache" (depends on
# the number of metrics, indexing building with "file-list-cache" is usually
# much faster than re-scanning the whole file tree after restart).
no-service-when-index-is-not-ready = false

# This provides the ability to query for new metrics without any wsp files
# i.e query for metrics present only in cache. Does a cache-scan and
# populates index with metrics with or without corresponding wsp files,
# but will lead to increased memory consumption. Disabled by default.
cache-scan = false

# Maximum amount of globs in a single metric in index
# This value is used to speed-up /find requests with
# a lot of globs, but will lead to increased memory consumption
max-globs = 100
# Fail if amount of globs more than max-globs
fail-on-max-globs = false

# Maximum metrics could be returned by glob/wildcard in find request (currently
# works only for trie index) (Default: 10,000,000)
max-metrics-globbed  = 30000
# Maximum metrics could be returned in render request (works both all types of
# indexes) (Default: 1,000,000)
max-metrics-rendered = 1000
# Maximum number of goroutines (i.e. threads) to fetch data from disk/cache
# (Default: 2 x max-cpu)
max-fetch-data-goroutines = 0

# graphite-web-10-mode
# Use Graphite-web 1.0 native structs for pickle response
# This mode will break compatibility with graphite-web 0.9.x
# If false, carbonserver won't send graphite-web 1.0 specific structs
# That might degrade performance of the cluster
# But will be compatible with both graphite-web 1.0 and 0.9.x
graphite-web-10-strict-mode = true

# Return a 404 instead of empty results. Set to true if you are serving requests to graphite-web
empty-result-ok = false

# Do not log metric-not-found errors for render and find (HTTP 404 / gRPC NotFound).
# Useful for sharded stores, where a missing metric is an expected result.
do-not-log-404s = false

# Allows to keep track for "last time readed" between restarts, leave empty to disable
internal-stats-dir = ""
# Calculate /render request time percentiles for the bucket, '95' means calculate 95th Percentile. 
# To disable this feature, leave the list blank
stats-percentiles = [99, 98, 95, 75, 50]

# heavy-glob-query-rate-limiters is a narrow control against queries that might
# causes high cpu and memory consumption due to matching over too many metrics
# or nodes at the same time, queries like: "*.*.*.*.*.*.*.*.*keyword*". For
# these types of queries, trigram might be able to handle it better, but for
# trie and filesystem glob, it's too expensive.
#
# pattern is a Go regular expression: https://pkg.go.dev/regexp/syntax.
#
# When max-inflight-requests is set to 0, it means instant rejection.
# When max-inflight-requests is set as a positive integer and when there are too
# many concurrent requests, it would block/delay the request until the previous ones
# are completed.
#
# The configs are order sensitive and are applied top down. The current
# implementation is in an O(n) so it's advised not to apply too many rules here
# as they are applied on all the queries.
#
# [[carbonserver.heavy-glob-query-rate-limiters]]
# pattern = "^(\*\.){5,}"
# max-inflight-requests = 1
#
# [[carbonserver.heavy-glob-query-rate-limiters]]
# pattern = "^sys(\*\.){7,}"
# max-inflight-requests = 0

# api-per-path-rate-limiters are used for strict api call rate limiting. All
# registered API paths (see carbonserver.Listen for a full list) can be
# controlled separately here:
#
#     "/_internal/capabilities/"
#     "/metrics/find/"
#     "/metrics/list/"
#     "/metrics/list_query/"
#     "/metrics/namespace-hashes/"
#     "/metrics/details/"
#     "/render/"
#     "/info/"
#     "/forcescan"
#     "/admin/quota"
#     "/admin/info"
#     "/robots.txt"
#     ...
#
# When max-inflight-requests is set to 0, it means instant rejection.
# When max-inflight-requests is set as a positive integer and when there are too
# many concurrent requests, it would block/delay the request until the previous
# ones are completed.
#
# request-timeout would override the global request-timeout.
#
# [[carbonserver.api-per-path-rate-limiters]]
# path = "/metrics/list/"
# max-inflight-requests = 1
# request-timeout = "600s"
#
# [[carbonserver.api-per-path-rate-limiters]]
# path = "/metrics/list_query/"
# max-inflight-requests = 3
#
# For gRPC rpcs, path should be full method name.
#
# [[carbonserver.api-per-path-rate-limiters]]
# path = "/carbonapi_v2_grpc.CarbonV2/Render"
# max-inflight-requests = 10
# request-timeout = "40s"

# Optional find/glob cache TTL overrides for small, frequently changing namespaces.
# Unmatched queries keep the five-minute TTL. Prefixes are literal metric paths;
# matching includes the prefix itself and its dot-separated descendants. The
# longest matching prefix wins. A batch uses its longest per-query TTL, so an
# unrelated query in the same batch keeps its normal cache lifetime. Wildcards
# before the configured prefix do not match an override. Whole seconds only;
# applied at startup. Upstream caches can add their own discovery delay.
#
# [carbonserver.discovery-cache-ttl]
# "aggregations.secondly._meta" = "15s"

# carbonserver.grpc is the configuration for listening for grpc clients.
# Note: currently, only CarbonV2 Render rpc is implemented.
# [carbonserver.grpc]
# enabled = true
# listen = ":7004"


[dump]
# Enable dump/restore function on USR2 signal
enabled = false
# Directory for store dump data. Should be writeable for carbon
path = "/var/lib/graphite/dump/"
# Restore speed. 0 - unlimited
#
# With whisper compressed = true the dump is restored before the receivers start
# listening, so replayed points cannot fall behind a block watermark that live
# traffic has already advanced. A non-zero limit therefore delays startup by
# roughly (dumped points / restore-per-second) seconds plus the time needed to
# persist them, during which nothing is accepted: keep it high enough that a
# restart finishes inside whatever grace period your health check or supervisor
# allows.
restore-per-second = 0
# Run as a small parent process that exits as soon as a USR2 dump stop has
# written its durable files and closed every listener, instead of waiting for
# the worker to exit. Freeing a large heap can take several seconds of kernel
# time; with a service manager that only tracks the main process (for systemd,
# KillMode=process) the next instance starts while that memory is reclaimed.
# The host needs room for both processes briefly. Not supported with -daemon.
# When both binaries support input handoff, a store with only the built-in
# uncompressed, unbuffered TCP receiver also transfers its existing ingestion
# connections. Input received after the checkpoint is replayed before reading
# the transferred connections. Other receiver configurations use stop/rebind.
handoff-supervisor = false
# A shared store (whisper.storage-backend = "pebble-chunk" without mirrored
# files) cannot hand its reads over: their data is in a database only one
# process opens. With this enabled, and the same receiver and successor
# requirements as above, the stopping instance still keeps reading input into
# its tail log, closes the database, releases the supervisor and hands the
# input sockets to the next instance once that has opened the database, so
# senders never see input closed; reads restart as before. The worker outlives
# the supervisor for that time, so the service manager must track only the main
# process (systemd KillMode=process). Without a capable successor, or if it
# does not take input within 20 s of its release, input stops as without
# handoff. The successor is the binary systemd's ExecStart names (so a rollback
# through a drop-in pointing at an older binary gets a plain stop), and the
# process that registers is checked again: one that cannot take input makes
# input stop at once. Input received after the checkpoint is replayed before
# the successor reads input, which on large stores runs at ~0.5M points/s.
store-input-handoff = false
# Record format of the dump a stop writes: "legacy", "compact", or "blocks".
# "compact" writes each metric's points in the cache's in-memory encoding,
# copied without decoding, with a third of the dump CPU of "legacy", and
# restore copies the bytes back into the cache (cache-compact.*.bin).
# "blocks" additionally names each block of records once, sorted and front coded under
# zstd: where metrics hold few points each, names were most of a dump's
# bytes. On cache shards sampled from production stores: 557 -> 72 bytes per
# metric with 19 points and 495-byte names per metric, 699 -> 529 with 176
# points and 195-byte names. Name compression uses more CPU: keep "compact"
# on dense workloads when stop time matters more than dump size; use "blocks"
# for workloads dominated by metric names.
# With a pending read checkpoint, the input
# received during the dump goes to a compact input file too (about 13
# instead of 157 bytes per point), whose checkpoint index is written before
# input closes. For "blocks", it lists no records: about 25 instead of 100
# bytes per metric. Restore and pending checkpoint reads accept every format,
# whatever this setting.
# Releases without this setting ignore compact files (cache-compact.*.bin,
# cache-blocks.*.bin, input-compact.*.bin), and releases that write
# cache-compact.*.bin ignore cache-blocks.*.bin: after a rollback to one, the
# points they hold are not restored (the files stay in place); a later start
# of a release that reads them restores such files, oldest first. Before
# rolling back, set format = "legacy" and reload with SIGHUP: the stop then
# writes legacy files, also of points restored from compact ones.
format = "legacy"

[input-log]
# Continuous log of the points accepted into the cache, so that an unclean
# exit (kill -9, OOM kill, power loss) loses only about sync-interval of input
# instead of every point not yet persisted, which with writeout batching can
# be minutes. On start the log is replayed before any receiver opens, after a
# pending dump checkpoint and before legacy dump files.
#
# Points are recorded in per-shard buffers under the cache shard lock, then
# written once per sync-interval as zstd-compressed frames: one large write
# and one fdatasync per interval, into preallocated segment files that are
# recycled once every point in them has been persisted. Each segment records
# a metric name once and refers to it by a small id afterwards, and encodes
# each point against the metric's previous point in that segment.
#
# A graceful dump stop (USR2 with [dump] enabled, which is also what
# systemctl stop sends with KillSignal=USR2) deletes the log after the dump
# and its input file are durable, so their points are restored once, from the
# dump. If the dump fails or the stop is killed before that, the log stays and
# the next start replays it. With [dump] disabled, USR2 stops input and syncs
# the log; the next start replays it. SIGTERM and SIGKILL end the process at
# once: the next start replays the log, losing at most one sync-interval.
#
# Restart only: SIGHUP refuses a configuration that changes this section, or
# that raises cache.writeout-max-delay to the running log's max-age.
enabled = false
# Directory of the log segments. It must not be dump.path; a subdirectory is
# fine. Disk use is the log's write rate times the age of the oldest
# unpersisted point (up to cache.writeout-max-delay) plus truncate-lag. Metrics
# sending every few seconds cost about 5 bytes per point, about 20 MB/s at
# 4.5M points/s; metrics sending less often than a segment lasts cost about
# 30 bytes per point, since every segment records their names again.
path = "/var/lib/graphite/input-log/"
# Group commit period: the most input an unclean exit loses.
sync-interval = "1s"
# Preallocated size of each segment file, in bytes (at least 16MB). Each
# segment records every name it uses once, about 30 bytes per active metric,
# so it should hold much more than that: at least a minute of input. Larger
# segments record names less often: with 29M active metrics at 1M points/s,
# 1 GiB segments wrote 8.8 MB/s and 4 GiB segments 2.2 MB/s. The log keeps
# up to about six segments preallocated, so budget about 6 x segment-size of
# disk (24 GiB at the default); lower it on small disks.
segment-size = 4294967296
# Points still unpersisted after max-age (a write that keeps failing, or a
# persister that is far behind) are recorded again at the head of the log,
# so they no longer keep older segments. Bounds the log to about max-age of
# input. "0s" (default) uses twice cache.writeout-max-delay, at least 30m.
# It must exceed cache.writeout-max-delay, or points waiting for their
# writeout are logged twice, and be at least two sync intervals.
max-age = "0s"
# Segments are reused only this long after their points are confirmed, so a
# confirmed write still in the page cache or an unsynced store WAL survives a
# power loss. "0s" protects against process crashes only.
truncate-lag = "1m"

[pprof]
listen = "localhost:7007"
enabled = false
# Process-wide sampling, applied at start and on SIGHUP (also with pprof disabled).
# Mutex: sample one in N contention events; 0 disables. Start with 100.
mutex-profile-fraction = 0
# Block: average nanoseconds of blocking per sample; 0 disables.
# Start with 1000000 (1ms); this is a duration in ns, not a sampling fraction.
block-profile-rate = 0

#[prometheus]
#enabled = true

#[prometheus.labels]
#foo = "test"
#bar = "baz"

# Default logger
[[logging]]
# logger name
# available loggers:
# * "" - default logger for all messages without configured special logger
# @TODO
logger = ""
# Log output: filename, "stderr", "stdout", "none", "" (same as "stderr")
file = "/var/log/go-carbon/go-carbon.log"
# Log level: "debug", "info", "warn", "error", "dpanic", "panic", and "fatal"
level = "info"
# Log format: "json", "console", "mixed"
encoding = "mixed"
# Log time format: "millis", "nanos", "epoch", "iso8601"
encoding-time = "iso8601"
# Log duration format: "seconds", "nanos", "string"
encoding-duration = "seconds"

# You can define multiply loggers:

# Copy errors to stderr for systemd
# [[logging]]
# logger = ""
# file = "stderr"
# level = "error"
# encoding = "mixed"
# encoding-time = "iso8601"
# encoding-duration = "seconds"
